{
    "$schema":  "./node_modules/@angular/cli/lib/config/schema.json",
    "version":  1,
    "projects":  {
                     "bsg-web-ui":  {
                                        "projectType":  "application",
                                        "root":  "",
                                        "sourceRoot":  "src",
                                        "prefix":  "bsg",
                                        "architect":  {
                                                          "build":  {
                                                                        "builder":  "@angular-devkit/build-angular:application",
                                                                        "options":  {
                                                                                        "outputPath":  "dist/bsg-web-ui",
                                                                                        "index":  "src/index.html",
                                                                                        "browser":  "src/main.ts",
                                                                                        "polyfills":  [
                                                                                                          "zone.js"
                                                                                                      ],
                                                                                        "tsConfig":  "tsconfig.app.json",
                                                                                        "inlineStyleLanguage":  "scss",
                                                                                        "assets":  [
                                                                                                       "src/favicon.svg",
                                                                                                       "src/robots.txt",
                                                                                                       "src/sitemap.xml",
                                                                                                       "src/CNAME",
                                                                                                       "src/404.html"
                                                                                                   ],
                                                                                        "styles":  [
                                                                                                       "src/styles.scss"
                                                                                                   ]
                                                                                    },
                                                                        "configurations":  {
                                                                                               "production":  {
                                                                                                                  "budgets":  [
                                                                                                                                  {
                                                                                                                                      "type":  "initial",
                                                                                                                                      "maximumWarning":  "700kb",
                                                                                                                                      "maximumError":  "1.2mb"
                                                                                                                                  }
                                                                                                                              ],
                                                                                                                  "outputHashing":  "all"
                                                                                                              },
                                                                                               "development":  {
                                                                                                                   "optimization":  false,
                                                                                                                   "extractLicenses":  false,
                                                                                                                   "sourceMap":  true
                                                                                                               }
                                                                                           },
                                                                        "defaultConfiguration":  "production"
                                                                    },
                                                          "serve":  {
                                                                        "builder":  "@angular-devkit/build-angular:dev-server",
                                                                        "configurations":  {
                                                                                               "production":  {
                                                                                                                  "buildTarget":  "bsg-web-ui:build:production"
                                                                                                              },
                                                                                               "development":  {
                                                                                                                   "buildTarget":  "bsg-web-ui:build:development"
                                                                                                               }
                                                                                           },
                                                                        "defaultConfiguration":  "development"
                                                                    }
                                                      }
                                    }
                 },
    "cli":  {
                "analytics":  false
            }
}
